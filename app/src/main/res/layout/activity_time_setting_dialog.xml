                android:id="@+id/negative_botton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:padding="0sp"

                android:backgroundTint="@color/transparency"

                android:src="@drawable/canclebtn"

